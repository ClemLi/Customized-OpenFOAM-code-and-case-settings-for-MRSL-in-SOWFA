FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

  application       superDeliciousVanilla;

  libs              ("libSOWFAboundaryConditions.so" "libSOWFAincompressibleTurbulenceModels.so");

  startFrom         startTime;

  startTime         21600.0;  

  stopAt            endTime;

  endTime           36000.0;

  deltaT            0.36;   

  writeControl      timeStep;

  writeInterval     5000;

  purgeWrite        0;

  writeFormat       ascii;

  writePrecision    12;

  writeCompression  uncompressed;

  timeFormat        general;

  timePrecision     7;

  runTimeModifiable yes;

  adjustTimeStep    no;

  // maxCo             0.75;

  // maxDeltaT         25.0;

  functions
  {
    //#include "sampling/planarAveraging"
    //#include "sampling/boundaryData"
    //#include "sampling/temporalAverages"
    #include "sampling/sliceDataInstantaneous"
  }

