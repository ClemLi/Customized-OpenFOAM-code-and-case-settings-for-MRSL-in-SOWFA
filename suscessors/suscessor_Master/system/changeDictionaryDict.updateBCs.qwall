FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../setUp";


dictionaryReplacement
{

    qwall
    {
        boundaryField
        {
            lower
            {
                type            fixedValue;
                value           uniform $qwall;
            }

        }
    }

    Rwall
    {
        boundaryField
        {
            lower
            {
                type            SchumannGrotzbach;
                kappa           $kappa;
                z0              uniform $z0;
                betaM           $betaM;
                gammaM          $gammaM;
                averageType     "local";
                value           uniform (0 0 0 0 0 0);
            }
        }
    }
}
// ************************************************************************* //
